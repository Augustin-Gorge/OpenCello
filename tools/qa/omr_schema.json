{
  "_doc": "Schémas JSON de sortie contrainte (constrained decoding) pour le pipeline OMR local d'OpenCello. Voir docs/16-omr-local.md. Règle : rester dans le sous-ensemble supporté par le moteur de grammaire d'Ollama (pas de $ref, $defs, oneOf, anyOf, union de types, pattern) — tout est inliné. Les champs optionnels sont simplement absents. Les durées sont en temps (noires), quantifiées ensuite en divisions (1/48) par omr_json_to_musicxml.py.",
  "page_transcription": {
    "title": "PageTranscription",
    "type": "object",
    "required": ["page_number", "systems", "warnings"],
    "properties": {
      "page_number": {"type": "integer", "minimum": 1},
      "work_title": {"type": "string"},
      "composer": {"type": "string"},
      "tempo_bpm": {"type": "integer", "minimum": 20, "maximum": 240},
      "confidence": {"type": "integer", "minimum": 0, "maximum": 100},
      "warnings": {"type": "array", "items": {"type": "string"}, "maxItems": 20},
      "systems": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
          "type": "object",
          "required": ["part_name", "first_measure_number", "measures"],
          "properties": {
            "part_name": {"type": "string", "maxLength": 60},
            "first_measure_number": {"type": "integer", "minimum": 1},
            "key_fifths": {"type": "integer", "minimum": -7, "maximum": 7},
            "time_beats": {"type": "integer", "minimum": 1, "maximum": 16},
            "time_beat_type": {"type": "integer", "minimum": 1, "maximum": 32},
            "measures": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": ["events"],
                "properties": {
                  "number": {"type": "integer", "minimum": 1},
                  "key_fifths": {"type": "integer", "minimum": -7, "maximum": 7},
                  "time_beats": {"type": "integer", "minimum": 1, "maximum": 16},
                  "time_beat_type": {"type": "integer", "minimum": 1, "maximum": 32},
                  "start_repeat": {"type": "boolean"},
                  "end_repeat": {"type": "boolean"},
                  "ending_number": {"type": "integer", "minimum": 1, "maximum": 8},
                  "ending_type": {"type": "string", "enum": ["start", "stop", "discontinue"]},
                  "segno": {"type": "boolean"},
                  "coda": {"type": "boolean"},
                  "fine": {"type": "boolean"},
                  "dc_al_coda": {"type": "boolean"},
                  "ds_al_coda": {"type": "boolean"},
                  "dc_al_fine": {"type": "boolean"},
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 256,
                    "items": {
                      "type": "object",
                      "required": ["notes", "duration_beats"],
                      "properties": {
                        "voice": {"type": "integer", "minimum": 1, "maximum": 4},
                        "duration_beats": {"type": "number", "minimum": 0.02, "maximum": 32},
                        "tie_start": {"type": "boolean"},
                        "tie_stop": {"type": "boolean"},
                        "notes": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "object",
                            "required": ["step", "octave"],
                            "properties": {
                              "step": {"type": "string", "enum": ["C", "D", "E", "F", "G", "A", "B"]},
                              "alter": {"type": "integer", "minimum": -2, "maximum": 2},
                              "octave": {"type": "integer", "minimum": 1, "maximum": 8},
                              "is_rest": {"type": "boolean"},
                              "is_chord": {"type": "boolean"},
                              "is_grace": {"type": "boolean"}
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "score_document": {
    "title": "ScoreDocument",
    "type": "object",
    "required": ["parts"],
    "properties": {
      "work_title": {"type": "string"},
      "composer": {"type": "string"},
      "tempo_bpm": {"type": "integer", "minimum": 20, "maximum": 240},
      "warnings": {"type": "array", "items": {"type": "string"}, "maxItems": 40},
      "parts": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": {
          "type": "object",
          "required": ["name", "measures"],
          "properties": {
            "name": {"type": "string", "maxLength": 60},
            "measures": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2048,
              "items": {
                "type": "object",
                "required": ["number", "events"],
                "properties": {
                  "number": {"type": "integer", "minimum": 1},
                  "key_fifths": {"type": "integer", "minimum": -7, "maximum": 7},
                  "time_beats": {"type": "integer", "minimum": 1, "maximum": 16},
                  "time_beat_type": {"type": "integer", "minimum": 1, "maximum": 32},
                  "start_repeat": {"type": "boolean"},
                  "end_repeat": {"type": "boolean"},
                  "ending_number": {"type": "integer", "minimum": 1, "maximum": 8},
                  "ending_type": {"type": "string", "enum": ["start", "stop", "discontinue"]},
                  "segno": {"type": "boolean"},
                  "coda": {"type": "boolean"},
                  "fine": {"type": "boolean"},
                  "dc_al_coda": {"type": "boolean"},
                  "ds_al_coda": {"type": "boolean"},
                  "dc_al_fine": {"type": "boolean"},
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 256,
                    "items": {
                      "type": "object",
                      "required": ["notes", "duration_beats"],
                      "properties": {
                        "voice": {"type": "integer", "minimum": 1, "maximum": 4},
                        "duration_beats": {"type": "number", "minimum": 0.02, "maximum": 32},
                        "tie_start": {"type": "boolean"},
                        "tie_stop": {"type": "boolean"},
                        "notes": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 6,
                          "items": {
                            "type": "object",
                            "required": ["step", "octave"],
                            "properties": {
                              "step": {"type": "string", "enum": ["C", "D", "E", "F", "G", "A", "B"]},
                              "alter": {"type": "integer", "minimum": -2, "maximum": 2},
                              "octave": {"type": "integer", "minimum": 1, "maximum": 8},
                              "is_rest": {"type": "boolean"},
                              "is_chord": {"type": "boolean"},
                              "is_grace": {"type": "boolean"}
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "repair_edits": {
    "title": "RepairEdits",
    "type": "object",
    "required": ["explanation", "edits"],
    "properties": {
      "explanation": {"type": "string"},
      "edits": {
        "type": "array",
        "minItems": 1,
        "maxItems": 128,
        "items": {
          "type": "object",
          "required": ["part", "measure_number", "action"],
          "properties": {
            "part": {"type": "string"},
            "measure_number": {"type": "integer", "minimum": 1},
            "action": {
              "type": "string",
              "enum": [
                "replace_event",
                "insert_event",
                "delete_event",
                "set_time_signature",
                "set_key_signature"
              ]
            },
            "event_index": {"type": "integer", "minimum": 0},
            "event": {
              "type": "object",
              "required": ["notes", "duration_beats"],
              "properties": {
                "voice": {"type": "integer", "minimum": 1, "maximum": 4},
                "duration_beats": {"type": "number", "minimum": 0.02, "maximum": 32},
                "tie_start": {"type": "boolean"},
                "tie_stop": {"type": "boolean"},
                "notes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "required": ["step", "octave"],
                    "properties": {
                      "step": {"type": "string", "enum": ["C", "D", "E", "F", "G", "A", "B"]},
                      "alter": {"type": "integer", "minimum": -2, "maximum": 2},
                      "octave": {"type": "integer", "minimum": 1, "maximum": 8},
                      "is_rest": {"type": "boolean"},
                      "is_chord": {"type": "boolean"},
                      "is_grace": {"type": "boolean"}
                    }
                  }
                }
              }
            },
            "time_beats": {"type": "integer", "minimum": 1, "maximum": 16},
            "time_beat_type": {"type": "integer", "minimum": 1, "maximum": 32},
            "key_fifths": {"type": "integer", "minimum": -7, "maximum": 7}
          }
        }
      }
    }
  }
}
